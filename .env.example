# Local Postgres started by docker compose
DATABASE_URL=postgres://storeit:storeit@localhost:5436/storeit

# Signs session cookies and OTP hashes. Use a long random value in production.
AUTH_SECRET=replace-with-a-long-random-string

# Protects POST /api/cron/sweep
CRON_SECRET=replace-with-a-long-random-string

# Per-user storage cap in bytes. Default is 2 GB when unset.
STORAGE_QUOTA_BYTES=2147483648

# Redis from docker compose
REDIS_URL=redis://127.0.0.1:6380

# ClamAV from docker compose. Leave unset only for a local demo without scanning.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Origin of this app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# S3-compatible object storage.
# Local MinIO from docker compose (console: http://localhost:9011)
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=storeit
S3_ACCESS_KEY_ID=storeit
S3_SECRET_ACCESS_KEY=storeit-secret
S3_FORCE_PATH_STYLE=true

# Cloudflare R2 uses the same variables. Create the bucket in the R2 dashboard,
# then replace the block above. Keep path style so signed URLs stay on one host.
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=storeit
# S3_ACCESS_KEY_ID=<r2_access_key_id>
# S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
# S3_FORCE_PATH_STYLE=true

# Local mail catcher from docker compose. Inbox UI: http://localhost:8026
# `bun dev` always uses this, even if RESEND_API_KEY is set below.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
MAIL_FROM=StoreIt <noreply@storeit.local>

# Production only. Resend is used when NODE_ENV=production and this key is set.
# Verify a domain first, then set MAIL_FROM to an address on that domain.
# The default Resend key only sends from onboarding@resend.dev, and only to
# the address on the Resend account.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=StoreIt <noreply@yourdomain.com>
